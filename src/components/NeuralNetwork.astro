<div
  x-data="neuralNetwork()"
  x-init="init()"
  @resize.window.debounce.100ms="onResize()"
  class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
  aria-hidden="true"
>
  <!-- Atmospheric soft glows -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_68%_38%,rgba(183,243,77,0.11),transparent_42%),radial-gradient(circle_at_18%_65%,rgba(64,123,255,0.08),transparent_38%)]"></div>

  <!-- Interactive HTML5 Canvas Neural Network -->
  <canvas
    x-ref="canvas"
    class="pointer-events-none absolute inset-0 h-full w-full opacity-90 transition-opacity duration-700"
  ></canvas>
</div>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('neuralNetwork', () => ({
      canvas: null,
      ctx: null,
      width: 0,
      height: 0,
      dpr: 1,
      animId: null,
      particles: [],
      mouse: {
        x: -9999,
        y: -9999,
        active: false,
        radius: 170, // Raio de perturbação do cursor onde as linhas se desfazem
      },
      synapseRadius: 135, // Distância máxima padrão entre nós para formar conexões
      pulses: [], // Pulsos de informação viajando pela rede

      init() {
        this.canvas = this.$refs.canvas;
        this.ctx = this.canvas.getContext('2d');
        this.dpr = Math.min(window.devicePixelRatio || 1, 2);

        this.onResize();
        this.createParticles();

        // Mouse listeners globais
        this.handlePointerMove = (e) => {
          const rect = this.canvas.getBoundingClientRect();
          this.mouse.x = e.clientX - rect.left;
          this.mouse.y = e.clientY - rect.top;
          this.mouse.active = true;
        };

        this.handlePointerLeave = () => {
          this.mouse.active = false;
          this.mouse.x = -9999;
          this.mouse.y = -9999;
        };

        window.addEventListener('pointermove', this.handlePointerMove, { passive: true });
        document.addEventListener('mouseleave', this.handlePointerLeave);

        // Disparar pulsos sinápticos elétricos aleatórios
        this.pulseInterval = setInterval(() => {
          if (this.particles.length > 5) {
            const startNode = this.particles[Math.floor(Math.random() * this.particles.length)];
            startNode.pulse = 1.0;
          }
        }, 1200);

        this.loop = this.loop.bind(this);
        this.animId = requestAnimationFrame(this.loop);
      },

      destroy() {
        if (this.animId) cancelAnimationFrame(this.animId);
        if (this.pulseInterval) clearInterval(this.pulseInterval);
        window.removeEventListener('pointermove', this.handlePointerMove);
        document.removeEventListener('mouseleave', this.handlePointerLeave);
      },

      onResize() {
        if (!this.canvas) return;
        const rect = this.canvas.parentElement.getBoundingClientRect();
        this.width = rect.width;
        this.height = rect.height;

        this.canvas.width = this.width * this.dpr;
        this.canvas.height = this.height * this.dpr;
        this.ctx.scale(this.dpr, this.dpr);

        if (this.particles && this.particles.length > 0) {
          // Manter nós nos limites após resize
          this.particles.forEach(p => {
            if (p.x > this.width) p.x = Math.random() * this.width;
            if (p.y > this.height) p.y = Math.random() * this.height;
          });
        }
      },

      createParticles() {
        this.particles = [];
        // Densidade inteligente baseada na resolução da tela
        const area = this.width * this.height;
        const count = Math.min(Math.max(Math.floor(area / 11000), 45), 110);

        // Nós organizados em camadas neurais com variação orgânica
        for (let i = 0; i < count; i++) {
          const x = Math.random() * this.width;
          const y = Math.random() * this.height;
          
          this.particles.push({
            x,
            y,
            originX: x,
            originY: y,
            vx: (Math.random() - 0.5) * 0.5,
            vy: (Math.random() - 0.5) * 0.5,
            radius: Math.random() < 0.25 ? 3.2 : Math.random() < 0.6 ? 2.2 : 1.5,
            baseRadius: 0,
            pulse: 0,
            energy: Math.random() * Math.PI * 2,
            isCore: Math.random() < 0.18, // Neurônio principal com halo
          });
        }
      },

      loop() {
        this.ctx.clearRect(0, 0, this.width, this.height);

        const time = performance.now() * 0.001;
        const mouse = this.mouse;
        const maxDist = this.synapseRadius;
        const mouseR = mouse.radius;

        // 1. Atualizar física dos neurônios
        for (let i = 0; i < this.particles.length; i++) {
          const p = this.particles[i];

          // Movimento suave contínuo tipo flutuação sináptica
          p.x += p.vx + Math.sin(time + p.energy) * 0.15;
          p.y += p.vy + Math.cos(time + p.energy) * 0.15;

          // Rebatimento suave nas bordas
          if (p.x < 10) { p.x = 10; p.vx *= -1; }
          else if (p.x > this.width - 10) { p.x = this.width - 10; p.vx *= -1; }

          if (p.y < 10) { p.y = 10; p.vy *= -1; }
          else if (p.y > this.height - 10) { p.y = this.height - 10; p.vy *= -1; }

          // Efeito de repulsão / perturbação nos neurônios quando o mouse está próximo
          if (mouse.active) {
            const dx = p.x - mouse.x;
            const dy = p.y - mouse.y;
            const dist = Math.hypot(dx, dy);

            if (dist < mouseR && dist > 0.001) {
              // Força de repulsão inversamente proporcional à distância
              const force = (1 - dist / mouseR) * 3.5;
              const nx = dx / dist;
              const ny = dy / dist;
              p.x += nx * force;
              p.y += ny * force;
            }
          }

          // Dissipação de pulso energético
          if (p.pulse > 0.02) {
            p.pulse *= 0.94;
          } else {
            p.pulse = 0;
          }
        }

        // 2. Traçar conexões sinápticas que se desfazem na passagem do mouse
        this.ctx.lineWidth = 1;
        for (let i = 0; i < this.particles.length; i++) {
          const p1 = this.particles[i];

          for (let j = i + 1; j < this.particles.length; j++) {
            const p2 = this.particles[j];
            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const dist = Math.hypot(dx, dy);

            if (dist < maxDist) {
              // Calcular a menor distância da linha [p1 -> p2] até a posição do mouse
              let severance = 0; // 0 = conexão intacta, 1 = completamente rompida/desfeita

              if (mouse.active) {
                // Projeção do ponto do mouse sobre o segmento de reta da conexão
                const l2 = dist * dist;
                const t = Math.max(0, Math.min(1, ((mouse.x - p1.x) * dx + (mouse.y - p1.y) * dy) / l2));
                const projX = p1.x + t * dx;
                const projY = p1.y + t * dy;
                const distToMouse = Math.hypot(mouse.x - projX, mouse.y - projY);

                if (distToMouse < mouseR) {
                  // Conexão se dissolve e se dissipa próximo ao mouse
                  severance = Math.pow(1 - distToMouse / mouseR, 1.3);
                }
              }

              // Se a linha foi cortada pela proximidade do mouse, ela se desfaz gradualmente
              const baseAlpha = (1 - dist / maxDist) * 0.45;
              const finalAlpha = baseAlpha * (1 - severance);

              if (finalAlpha > 0.015) {
                // Propagação de pulso entre nós conectados
                const pulseStrength = Math.max(p1.pulse, p2.pulse);
                
                this.ctx.beginPath();
                this.ctx.moveTo(p1.x, p1.y);
                this.ctx.lineTo(p2.x, p2.y);

                if (pulseStrength > 0.1) {
                  // Sinapse disparando sinal luminoso com a cor primary (#b7f34d)
                  this.ctx.strokeStyle = `rgba(183, 243, 77, ${Math.min(finalAlpha + pulseStrength * 0.6, 0.95)})`;
                  this.ctx.lineWidth = 1.6;
                } else {
                  // Conexão neural padrão
                  this.ctx.strokeStyle = `rgba(183, 243, 77, ${finalAlpha})`;
                  this.ctx.lineWidth = 0.9;
                }
                this.ctx.stroke();

                // Disparo em cadeia: se um nó tem pulso forte, propaga para o vizinho próximo
                if (p1.pulse > 0.7 && p2.pulse < 0.2 && severance < 0.3) {
                  p2.pulse = p1.pulse * 0.85;
                }
              }
            }
          }
        }

        // 3. Desenhar neurônios / nós
        for (let i = 0; i < this.particles.length; i++) {
          const p = this.particles[i];
          const isExcited = p.pulse > 0.1;
          const radius = p.radius + (p.pulse * 2.5);

          // Glow ao redor de nós especiais ou excitados
          if (p.isCore || isExcited) {
            const glowR = radius * 3.8;
            const glowGrad = this.ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowR);
            glowGrad.addColorStop(0, isExcited ? 'rgba(183, 243, 77, 0.45)' : 'rgba(183, 243, 77, 0.2)');
            glowGrad.addColorStop(1, 'rgba(183, 243, 77, 0)');

            this.ctx.fillStyle = glowGrad;
            this.ctx.beginPath();
            this.ctx.arc(p.x, p.y, glowR, 0, Math.PI * 2);
            this.ctx.fill();
          }

          // Corpo do nó
          this.ctx.beginPath();
          this.ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
          this.ctx.fillStyle = isExcited
            ? 'rgba(255, 255, 255, 0.98)'
            : p.isCore
            ? 'rgba(183, 243, 77, 0.95)'
            : 'rgba(183, 243, 77, 0.65)';
          this.ctx.fill();
        }

        // 4. Efeito especial na posição do cursor do mouse (dissipador de campo sináptico)
        if (mouse.active) {
          const cursorGlow = this.ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, mouseR * 0.75);
          cursorGlow.addColorStop(0, 'rgba(183, 243, 77, 0.08)');
          cursorGlow.addColorStop(0.5, 'rgba(64, 123, 255, 0.04)');
          cursorGlow.addColorStop(1, 'rgba(183, 243, 77, 0)');

          this.ctx.fillStyle = cursorGlow;
          this.ctx.beginPath();
          this.ctx.arc(mouse.x, mouse.y, mouseR * 0.75, 0, Math.PI * 2);
          this.ctx.fill();
        }

        this.animId = requestAnimationFrame(this.loop);
      }
    }));
  });
</script>
