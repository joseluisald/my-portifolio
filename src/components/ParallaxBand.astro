---
import { ArrowUpRight, Sparkles, Terminal, Cpu } from "lucide-astro";
---

<section
  id="parallax-band"
  x-data="parallaxBand()"
  x-init="init()"
  class="relative isolate overflow-hidden border-y border-primary/20 bg-[#121c14] py-28 sm:py-36"
>
  <!-- Background radial grid with vertical parallax -->
  <div
    x-ref="bgGrid"
    class="pointer-events-none absolute inset-0 -z-20 opacity-25 transition-transform duration-75 ease-out will-change-transform [background-image:radial-gradient(circle_at_center,hsl(var(--primary))_1.5px,transparent_1.5px)] [background-size:28px_28px]"
  ></div>

  <!-- Ambient glowing spheres reacting to scroll -->
  <div
    x-ref="glowOrb1"
    class="pointer-events-none absolute -left-20 top-1/4 -z-10 h-72 w-72 rounded-full bg-primary/10 blur-[100px] will-change-transform"
  ></div>
  <div
    x-ref="glowOrb2"
    class="pointer-events-none absolute -right-20 bottom-1/4 -z-10 h-80 w-80 rounded-full bg-blue-500/10 blur-[120px] will-change-transform"
  ></div>

  <!-- Parallax Typography Layer 1: Moving right to left on scroll -->
  <div
    class="pointer-events-none absolute top-8 -z-10 w-[200vw] select-none overflow-hidden will-change-transform"
    aria-hidden="true"
  >
    <div
      x-ref="trackTop"
      class="flex gap-12 whitespace-nowrap font-display text-[clamp(4.5rem,14vw,11rem)] font-extrabold uppercase leading-none tracking-[-0.08em] text-primary/[0.05] will-change-transform"
    >
      <span>JLA CODE</span>
      <span>•</span>
      <span>FULL STACK</span>
      <span>•</span>
      <span>CLOUD NATIVE</span>
      <span>•</span>
      <span>HIGH SPEED</span>
      <span>•</span>
      <span>JLA CODE</span>
      <span>•</span>
      <span>FULL STACK</span>
    </div>
  </div>

  <!-- Parallax Typography Layer 2: Moving left to right (inverse) with stroked hollow typography -->
  <div
    class="pointer-events-none absolute bottom-6 -z-10 w-[200vw] select-none overflow-hidden will-change-transform"
    aria-hidden="true"
  >
    <div
      x-ref="trackBottom"
      class="flex gap-12 whitespace-nowrap font-display text-[clamp(4.5rem,14vw,11rem)] font-extrabold uppercase leading-none tracking-[-0.08em] text-transparent will-change-transform [-webkit-text-stroke:1px_rgba(183,243,77,0.12)]"
    >
      <span>PERFORMANCE</span>
      <span>•</span>
      <span>INTELIGÊNCIA</span>
      <span>•</span>
      <span>ARQUITETURA</span>
      <span>•</span>
      <span>PRODUÇÃO</span>
      <span>•</span>
      <span>PERFORMANCE</span>
      <span>•</span>
      <span>INTELIGÊNCIA</span>
    </div>
  </div>

  <!-- Foreground Content with differential parallax depth -->
  <div
    x-ref="content"
    class="relative z-10 mx-auto max-w-7xl px-5 transition-transform duration-75 ease-out will-change-transform sm:px-8 lg:px-10"
  >
    <div class="relative mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-xs font-mono font-semibold uppercase tracking-[0.16em] text-primary backdrop-blur-sm">
        <Sparkles class="h-3.5 w-3.5 animate-pulse text-primary" />
        / tecnologia em movimento
      </div>

      <h2 class="mt-7 font-display text-4xl font-semibold leading-[1.02] tracking-[-0.07em] text-foreground sm:text-6xl lg:text-7xl">
        A melhor stack é a que faz o seu projeto <span class="relative inline-block text-primary">
          avançar.
          <span class="absolute -bottom-1 left-0 h-1 w-full rounded-full bg-primary/40"></span>
        </span>
      </h2>

      <p class="mx-auto mt-7 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        Ferramentas modernas, escolhas conscientes e uma implementação que não cria complexidade onde ela não precisa existir. Código testado, escalável e pronto para o mundo real.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#contato"
          class="group inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-bold text-primary-foreground shadow-[0_0_24px_rgba(183,243,77,0.3)] transition-all duration-300 hover:shadow-[0_0_32px_rgba(183,243,77,0.5)] hover:brightness-105"
        >
          Encontrar a stack certa
          <ArrowUpRight class="h-4 w-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </a>

        <a
          href="#stacks"
          class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-6 py-3.5 text-sm font-medium text-foreground backdrop-blur-sm transition-colors hover:border-primary/50 hover:bg-card"
        >
          <Cpu class="h-4 w-4 text-primary" />
          Ver tecnologias suportadas
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('parallaxBand', () => ({
      isVisible: false,
      currentScrollY: 0,
      targetScrollY: 0,
      animId: null,

      init() {
        const section = this.$el;
        const trackTop = this.$refs.trackTop;
        const trackBottom = this.$refs.trackBottom;
        const content = this.$refs.content;
        const bgGrid = this.$refs.bgGrid;
        const glowOrb1 = this.$refs.glowOrb1;
        const glowOrb2 = this.$refs.glowOrb2;

        // Suave interpolação (lerp)
        let currentProgress = 0;
        let targetProgress = 0;

        const updateTarget = () => {
          const rect = section.getBoundingClientRect();
          const winHeight = window.innerHeight;

          // Se a seção está na janela visível
          if (rect.bottom >= -100 && rect.top <= winHeight + 100) {
            this.isVisible = true;
            // 0 quando a seção entra pela base da tela, 1 quando sai pelo topo
            const totalDistance = winHeight + rect.height;
            const currentPosition = winHeight - rect.top;
            targetProgress = Math.max(0, Math.min(1, currentPosition / totalDistance));
          } else {
            this.isVisible = false;
          }
        };

        const render = () => {
          // Lerp para transição super fluida e orgânica
          currentProgress += (targetProgress - currentProgress) * 0.12;

          if (this.isVisible || Math.abs(targetProgress - currentProgress) > 0.001) {
            // Centralizado em torno de 0.5 (-0.5 a +0.5)
            const centered = currentProgress - 0.5;

            // Camada 1: Desliza da direita para esquerda
            if (trackTop) {
              const moveX1 = centered * -380; // px
              trackTop.style.transform = `translate3d(${moveX1}px, 0, 0)`;
            }

            // Camada 2: Desliza da esquerda para direita (efeito contrário)
            if (trackBottom) {
              const moveX2 = (centered * 380) - 200; // offset inicial para visual balanceado
              trackBottom.style.transform = `translate3d(${moveX2}px, 0, 0)`;
            }

            // Conteúdo principal: paralaxe vertical sutil de profundidade
            if (content) {
              const moveY = centered * -45; // flutua suavemente em sentido oposto ao scroll
              content.style.transform = `translate3d(0, ${moveY}px, 0)`;
            }

            // Grid de fundo se move mais devagar
            if (bgGrid) {
              const bgMoveY = centered * 60;
              bgGrid.style.transform = `translate3d(0, ${bgMoveY}px, 0)`;
            }

            // Orbs de luz com profundidade dinâmica
            if (glowOrb1) {
              glowOrb1.style.transform = `translate3d(0, ${centered * -90}px, 0)`;
            }
            if (glowOrb2) {
              glowOrb2.style.transform = `translate3d(0, ${centered * 90}px, 0)`;
            }
          }

          this.animId = requestAnimationFrame(render);
        };

        // Escutador de scroll e resize com passive para não travar o framerate
        window.addEventListener('scroll', updateTarget, { passive: true });
        window.addEventListener('resize', updateTarget, { passive: true });

        // Inicializar posição imediata
        updateTarget();
        currentProgress = targetProgress;
        this.animId = requestAnimationFrame(render);
      },

      destroy() {
        if (this.animId) cancelAnimationFrame(this.animId);
      }
    }));
  });
</script>
