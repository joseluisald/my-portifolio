---
import { ArrowUpRight, MessageCircle, ShieldCheck } from "lucide-astro";

const whatsappUrl = "https://wa.me/5553981302738?text=Ol%C3%A1%20Jos%C3%A9%2C%20vim%20pela%20JLA%20Code%20e%20quero%20conversar%20sobre%20um%20projeto.";
---

<section id="contato" data-motion-section class="border-t border-border bg-primary text-primary-foreground">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[1fr_0.9fr] lg:gap-24 lg:px-10 lg:py-28">
    <div data-motion-reveal>
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-primary-foreground/60">
        / vamos conversar
      </p>
      <h2 class="mt-6 max-w-xl font-display text-5xl font-semibold leading-[0.95] tracking-[-0.07em] sm:text-7xl">
        Tem um desafio? <span class="text-primary-foreground/50">Manda pra cá.</span>
      </h2>
      <p class="mt-7 max-w-md text-base leading-7 text-primary-foreground/70 sm:text-lg">
        Não precisa preencher formulário. Me chame pelo WhatsApp e conte, do seu jeito, o que você quer colocar de pé.
      </p>

      <div class="mt-10 flex flex-col items-start gap-5">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-motion-magnetic
          class="group inline-flex items-center gap-3 rounded-full bg-primary-foreground px-6 py-3.5 text-sm font-bold text-primary transition-all hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(38,52,13,0.2)]"
        >
          <MessageCircle class="h-5 w-5" />
          Abrir conversa no WhatsApp
          <ArrowUpRight class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </a>
        <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-primary-foreground/60">
          <ShieldCheck class="h-4 w-4" />
          Conversa inicial sem compromisso
        </div>
      </div>
    </div>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-motion-tilt
      data-motion-spotlight
      class="group rounded-2xl bg-primary-foreground p-7 text-foreground shadow-2xl shadow-[#26340d]/20 transition-transform sm:p-9"
    >
      <div class="flex items-start justify-between gap-6">
        <span class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">
          canal principal
        </span>
        <MessageCircle class="h-6 w-6 text-primary" />
      </div>
      <h3 class="mt-20 max-w-sm font-display text-3xl font-semibold leading-[1.02] tracking-[-0.06em] sm:text-4xl">
        Uma conversa resolve mais que um formulário.
      </h3>
      <p class="mt-5 max-w-sm text-sm leading-6 text-muted-foreground">
        Você explica o cenário com liberdade, eu faço as perguntas certas e juntos encontramos o próximo passo mais simples.
      </p>
      <div class="mt-10 flex items-center justify-between border-t border-border pt-5 text-sm font-bold">
        <span>Falar agora</span>
        <ArrowUpRight class="h-5 w-5 text-primary transition-transform group-hover:-translate-y-1 group-hover:translate-x-1" />
      </div>
    </a>
  </div>
</section>
