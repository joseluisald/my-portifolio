---
import { ArrowUpRight, Check, Send } from "lucide-astro";

const whatsappUrl = "https://wa.me/5553981302738?text=Ol%C3%A1%20Jos%C3%A9%2C%20vim%20pela%20JLA%20Code%20e%20quero%20conversar%20sobre%20um%20projeto.";
---

<section id="contato" class="border-t border-border bg-primary text-primary-foreground">
  <div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[1fr_0.9fr] lg:gap-24 lg:px-10 lg:py-28">
    <!-- Left Column: Copy & WhatsApp -->
    <div>
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-primary-foreground/60">
        / vamos conversar
      </p>
      <h2 class="mt-6 max-w-xl font-display text-5xl font-semibold leading-[0.95] tracking-[-0.07em] sm:text-7xl">
        Tem um desafio? <span class="text-primary-foreground/50">Manda pra cá.</span>
      </h2>
      <p class="mt-7 max-w-md text-base leading-7 text-primary-foreground/70 sm:text-lg">
        Me conte um pouco sobre o que você precisa. A primeira conversa é sem compromisso e já pode clarear bastante o caminho.
      </p>

      <div class="mt-10 flex flex-col items-start gap-5">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.12em] text-primary-foreground/60">
          <span class="h-2 w-2 rounded-full bg-primary-foreground"></span>
          Responderei assim que possível
        </div>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 text-sm font-bold text-primary-foreground underline decoration-primary-foreground/40 underline-offset-8 transition-opacity hover:opacity-70"
        >
          Ou fale diretamente pelo WhatsApp <ArrowUpRight class="h-4 w-4" />
        </a>
      </div>
    </div>

    <!-- Right Column: Interactive Form with Alpine.js -->
    <div
      x-data="{
        submitted: false,
        name: '',
        email: '',
        message: '',
        handleSubmit(e) {
          e.preventDefault();
          this.submitted = true;
        },
        resetForm() {
          this.submitted = false;
          this.name = '';
          this.email = '';
          this.message = '';
        }
      }"
      class="rounded-2xl bg-primary-foreground p-6 text-foreground shadow-2xl shadow-[#26340d]/20 sm:p-8"
    >
      <!-- Submitted State -->
      <div
        x-show="submitted"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        class="flex min-h-[320px] flex-col items-start justify-center"
        style="display: none;"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-primary-foreground">
          <Check class="h-6 w-6" />
        </div>
        <h3 class="mt-6 font-display text-3xl font-semibold tracking-[-0.05em]">
          Mensagem recebida.
        </h3>
        <p class="mt-3 max-w-sm text-sm leading-6 text-muted-foreground">
          Obrigado por compartilhar. Este é o começo de uma boa conversa.
        </p>
        <button
          type="button"
          @click="resetForm()"
          class="mt-8 text-sm font-bold text-foreground underline decoration-primary underline-offset-4 cursor-pointer hover:opacity-80 transition-opacity"
        >
          Enviar outra mensagem
        </button>
      </div>

      <!-- Form State -->
      <form
        x-show="!submitted"
        @submit="handleSubmit($event)"
        class="space-y-6"
      >
        <div>
          <label for="nome" class="mb-2 block font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">
            Seu nome
          </label>
          <input
            id="nome"
            name="nome"
            x-model="name"
            required
            placeholder="Como posso te chamar?"
            class="w-full border-b border-border bg-transparent px-0 py-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-primary"
          />
        </div>

        <div>
          <label for="email" class="mb-2 block font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">
            Seu e-mail
          </label>
          <input
            id="email"
            name="email"
            type="email"
            x-model="email"
            required
            placeholder="voce@exemplo.com"
            class="w-full border-b border-border bg-transparent px-0 py-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-primary"
          />
        </div>

        <div>
          <label for="mensagem" class="mb-2 block font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">
            O que você precisa?
          </label>
          <textarea
            id="mensagem"
            name="mensagem"
            rows="4"
            x-model="message"
            required
            placeholder="Conte um pouco sobre seu projeto ou desafio..."
            class="w-full resize-none border-b border-border bg-transparent px-0 py-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-primary"
          ></textarea>
        </div>

        <button
          type="submit"
          class="group mt-2 inline-flex w-full items-center justify-between rounded-full bg-foreground px-5 py-4 text-sm font-bold text-background transition-transform hover:-translate-y-0.5 cursor-pointer"
        >
          Enviar mensagem
          <Send class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </button>
      </form>
    </div>
  </div>
</section>
