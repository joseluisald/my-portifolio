---
import BrandMark from "./BrandMark.astro";
import { ChevronDown } from "lucide-astro";

const currentYear = new Date().getFullYear();
---

<footer class="bg-background border-t border-border/40">
  <div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-8 sm:px-8 md:flex-row md:items-center md:justify-between lg:px-10">
    <BrandMark />
    <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground">
      desenvolvimento com intenção © {currentYear}
    </p>
    <div class="flex items-center gap-5">
      <a
        href="https://www.linkedin.com/in/joseluisaldrighi/"
        target="_blank"
        rel="noreferrer"
        class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors"
      >
        LinkedIn
      </a>
      <a
        href="#inicio"
        class="flex items-center gap-1 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors cursor-pointer"
      >
        Voltar ao topo <ChevronDown class="h-3.5 w-3.5 rotate-180" />
      </a>
    </div>
  </div>
</footer>
