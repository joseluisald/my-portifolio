              <div class="mt-3.5 space-y-2.5">
                <template x-for="item in identidadeDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.identidadeVisual === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
