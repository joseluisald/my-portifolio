---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import logo from "@/assets/logo_jla.webp";
import {
  ArrowLeft,
  ArrowRight,
  Check,
  CheckCircle2,
  Copy,
  ExternalLink,
  HelpCircle,
  Layers,
  MessageCircle,
  Palette,
  Send,
  ShieldCheck,
  Sparkles,
  User,
  Phone,
  Server,
  Code2,
  Calendar,
  Zap,
} from "lucide-astro";

const whatsappNumber = "5553981302738";
---

<Layout
  title="Briefing de Projeto Web | JLA Code"
  description="Responda algumas perguntas rápidas sobre os objetivos, funcionalidades e expectativas do seu novo site para elaborarmos uma proposta personalizada e precisa."
>
  <!-- Background Atmospheric Mesh -->
  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 h-[500px] w-[900px] rounded-full bg-primary/10 blur-[140px]"></div>
    <div class="absolute top-1/3 -left-40 h-[400px] w-[400px] rounded-full bg-blue-500/5 blur-[120px]"></div>
    <div class="absolute bottom-10 right-0 h-[400px] w-[400px] rounded-full bg-primary/5 blur-[130px]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(183,243,77,0.035)_1px,transparent_1px)] [background-size:24px_24px]"></div>
  </div>

  <!-- Header Minimalista -->
  <header class="sticky top-0 z-40 border-b border-border/60 bg-background/85 backdrop-blur-xl">
    <div class="mx-auto flex h-[72px] max-w-5xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-90">
        <Image
          src={logo}
          quality={75}
          loading="eager"
          alt="Logo JLA Code"
          width={140}
          height={42}
        />
      </a>

      <div class="flex items-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-card/60 px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground"
        >
          <ArrowLeft class="h-3.5 w-3.5" />
          <span class="hidden sm:inline">Voltar ao site principal</span>
          <span class="sm:hidden">Início</span>
        </a>

        <a
          href={`https://wa.me/${whatsappNumber}?text=Ol%C3%A1%20Jos%C3%A9%2C%20estou%20preenchendo%20o%20briefing%20e%20fiquei%20com%20uma%20d%C3%BAvida.`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 border border-primary/30 px-3.5 py-1.5 text-xs font-semibold text-primary transition-all hover:bg-primary hover:text-primary-foreground"
        >
          <MessageCircle class="h-3.5 w-3.5" />
          <span class="hidden sm:inline">Tirar dúvida</span>
        </a>
      </div>
    </div>
  </header>

  <main
    x-data="briefingForm()"
    x-init="init()"
    class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-14 lg:px-8"
  >
    <!-- Card de Boas-Vindas Personalizado -->
    <div class="relative mb-8 overflow-hidden rounded-2xl border border-primary/25 bg-gradient-to-b from-card/90 to-card/50 p-6 backdrop-blur-md sm:p-8">
      <div class="absolute right-0 top-0 -mr-10 -mt-10 h-32 w-32 rounded-full bg-primary/10 blur-2xl"></div>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-xs font-bold uppercase tracking-[0.14em] text-primary">
            <Sparkles class="h-3.5 w-3.5 text-primary" />
            <span x-show="clienteNome" x-text="`Briefing Exclusivo • ${clienteNome}`"></span>
            <span x-show="!clienteNome">Briefing de Projeto Web</span>
          </div>

          <h1 class="mt-3 font-display text-2xl font-semibold leading-tight tracking-[-0.05em] text-foreground sm:text-4xl">
            <span x-show="clienteNome">
              Olá, <span class="text-primary" x-text="clienteNome"></span>! Vamos planejar seu novo site?
            </span>
            <span x-show="!clienteNome">
              Vamos construir a solução certa para o seu negócio?
            </span>
          </h1>

          <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
            Cada pergunta abaixo serve para entender o objetivo, o escopo e o investimento ideal para o seu projeto. Leva menos de 4 minutos para preencher.
          </p>
        </div>

        <!-- Indicador de Status VIP / Dados do Cliente -->
        <div class="flex flex-col gap-2 rounded-xl border border-border/70 bg-background/70 p-3.5 text-xs sm:min-w-[220px]">
          <div class="flex items-center justify-between text-muted-foreground">
            <span class="font-mono text-[10px] uppercase tracking-wider">Identificação</span>
            <button
              type="button"
              @click="showClientModal = true"
              class="text-primary hover:underline font-mono text-[11px]"
            >
              Editar dados
            </button>
          </div>
          <div class="font-semibold text-foreground flex items-center gap-1.5">
            <User class="h-3.5 w-3.5 text-primary shrink-0" />
            <span class="truncate" x-text="clienteNome || 'Cliente não identificado'"></span>
          </div>
          <div class="text-muted-foreground flex items-center gap-1.5" x-show="clienteTelefone">
            <Phone class="h-3.5 w-3.5 text-muted-foreground shrink-0" />
            <span class="font-mono text-[11px]" x-text="clienteTelefone"></span>
          </div>
        </div>
      </div>

      <!-- Barra de Progresso com Etapas -->
      <div class="mt-8 border-t border-border/50 pt-6">
        <div class="flex items-center justify-between text-xs mb-2">
          <span class="font-mono text-muted-foreground uppercase tracking-wider">
            Etapa <strong class="text-primary" x-text="currentStep"></strong> de 4: <span class="text-foreground font-medium" x-text="stepTitles[currentStep - 1]"></span>
          </span>
          <span class="font-mono font-bold text-primary" x-text="`${Math.round((currentStep / 4) * 100)}%`"></span>
        </div>
        <div class="h-2 w-full overflow-hidden rounded-full bg-secondary/50">
          <div
            class="h-full bg-gradient-to-r from-primary/80 to-primary transition-all duration-500 ease-out"
            :style="`width: ${(currentStep / 4) * 100}%`"
          ></div>
        </div>

        <!-- Navegador de passos em abas -->
        <div class="mt-4 grid grid-cols-4 gap-2 text-center text-xs">
          <template x-for="(title, idx) in stepTitles" :key="idx">
            <button
              type="button"
              @click="goToStep(idx + 1)"
              class="rounded-lg p-2 transition-all font-mono text-[11px]"
              :class="{
                'bg-primary/15 text-primary border border-primary/30 font-bold': currentStep === idx + 1,
                'bg-card/40 text-muted-foreground hover:text-foreground border border-transparent': currentStep !== idx + 1,
                'opacity-80': currentStep > idx + 1
              }"
            >
              <div class="flex items-center justify-center gap-1">
                <span
                  class="flex h-4 w-4 items-center justify-center rounded-full text-[9px] font-bold"
                  :class="currentStep > idx + 1 ? 'bg-primary text-primary-foreground' : (currentStep === idx + 1 ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground')"
                  x-text="currentStep > idx + 1 ? '✓' : idx + 1"
                ></span>
                <span class="hidden md:inline truncate" x-text="title"></span>
              </div>
            </button>
          </template>
        </div>
      </div>
    </div>

    <!-- FORMULÁRIO MULTI-ETAPAS -->
    <form @submit.prevent="submitBriefing()" class="space-y-6">

      <!-- ============================================== -->
      <!-- ETAPA 1: OBJETIVO E REFERÊNCIAS -->
      <!-- ============================================== -->
      <div x-show="currentStep === 1" x-transition.opacity.duration.250ms class="space-y-6">
        <div class="rounded-2xl border border-border/80 bg-card/60 p-6 sm:p-8 backdrop-blur-sm">
          <div class="flex items-center gap-2.5 text-primary">
            <Sparkles class="h-5 w-5" />
            <h2 class="font-display text-xl font-semibold text-foreground sm:text-2xl">
              1. Objetivo e Referências
            </h2>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">
            Defina o propósito central do projeto e nos mostre a estética visual que você busca.
          </p>

          <div class="mt-8 space-y-7">
            <!-- 1.1 Objetivo Principal -->
            <div>
              <label class="block text-sm font-semibold text-foreground">
                Qual é o objetivo principal do site? <span class="text-primary">*</span>
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Selecione a opção que melhor resume o papel do site no seu negócio.
              </p>

              <div class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
                <template x-for="item in objetivosDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.objetivoPrincipal === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="objetivoPrincipal"
                      :value="item.title"
                      x-model="form.objetivoPrincipal"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.objetivoPrincipal === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.objetivoPrincipal === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>

              <!-- Campo livre se selecionar Outro -->
              <div class="mt-3" x-show="form.objetivoPrincipal === 'Outro objetivo específico'">
                <input
                  type="text"
                  placeholder="Descreva brevemente o objetivo do seu site..."
                  x-model="form.objetivoOutro"
                  class="w-full rounded-xl border border-border/80 bg-background/90 px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                />
              </div>
            </div>

            <!-- 1.2 Referências que você gosta -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                Você tem referências de 2 ou 3 sites que você gosta?
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Pode ser pelo estilo visual, pelas cores, fluidez ou animações. Isso ajuda a calibrar a expectativa de design.
              </p>
              <div class="mt-3">
                <textarea
                  rows="3"
                  x-model="form.referenciasSites"
                  placeholder="Ex: 
- https://empresaexemplo.com (gosto da paleta sóbria e tipografia)
- https://stripe.com (gosto das animações modernas e visual tecnológico)"
                  class="w-full rounded-xl border border-border/80 bg-background/90 p-3.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                ></textarea>
              </div>
            </div>

            <!-- 1.3 Principais concorrentes -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                Quem são seus principais concorrentes?
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Sites ou perfis do seu setor para analisarmos o que eles fazem bem e onde o seu projeto pode se destacar.
              </p>
              <div class="mt-3">
                <textarea
                  rows="2"
                  x-model="form.concorrentes"
                  placeholder="Ex: Concorrente Alpha (www.alpha.com.br), Empresa Beta no Instagram..."
                  class="w-full rounded-xl border border-border/80 bg-background/90 p-3.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                ></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- Botões de Ação -->
        <div class="flex items-center justify-between">
          <span class="text-xs text-muted-foreground">Passo 1 de 4</span>
          <button
            type="button"
            @click="nextStep()"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground shadow-[0_0_20px_rgba(183,243,77,0.25)] transition-all hover:shadow-[0_0_28px_rgba(183,243,77,0.4)] hover:brightness-105"
          >
            Próxima etapa: Estrutura & Funcionalidades
            <ArrowRight class="h-4 w-4" />
          </button>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- ETAPA 2: ESTRUTURA E FUNCIONALIDADES -->
      <!-- ============================================== -->
      <div x-show="currentStep === 2" x-transition.opacity.duration.250ms class="space-y-6">
        <div class="rounded-2xl border border-border/80 bg-card/60 p-6 sm:p-8 backdrop-blur-sm">
          <div class="flex items-center gap-2.5 text-primary">
            <Layers class="h-5 w-5" />
            <h2 class="font-display text-xl font-semibold text-foreground sm:text-2xl">
              2. Estrutura e Funcionalidades
            </h2>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">
            O número de páginas e os recursos técnicos integrados são os fatores que mais afetam o escopo e o valor do projeto.
          </p>

          <div class="mt-8 space-y-7">
            <!-- 2.1 Quantidade de Páginas -->
            <div>
              <label class="block text-sm font-semibold text-foreground">
                Quantas páginas ou seções você imagina que o site terá? <span class="text-primary">*</span>
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Ex: Início, Quem Somos, Serviços, Galeria/Portfólio, Contato = 5 páginas.
              </p>

              <div class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
                <template x-for="item in paginasDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.quantidadePaginas === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="quantidadePaginas"
                      :value="item.title"
                      x-model="form.quantidadePaginas"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.quantidadePaginas === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.quantidadePaginas === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>

              <!-- Lista específica de páginas se o cliente quiser detalhar -->
              <div class="mt-3">
                <input
                  type="text"
                  placeholder="Quais páginas planeja ter? (Opcional, ex: Início, Tratamentos, Sobre, Depoimentos, Contato)"
                  x-model="form.paginasDetalhes"
                  class="w-full rounded-xl border border-border/80 bg-background/90 px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                />
              </div>
            </div>

            <!-- 2.2 Funcionalidades Especiais ou Integrações -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                O site precisará de alguma funcionalidade especial ou integração?
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Marque todas que fizerem sentido para o seu negócio.
              </p>

              <div class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
                <template x-for="feat in funcionalidadesDisponiveis" :key="feat.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.funcionalidades.includes(feat.title) ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="checkbox"
                      :value="feat.title"
                      x-model="form.funcionalidades"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded border transition-all"
                      :class="form.funcionalidades.includes(feat.title) ? 'border-primary bg-primary text-primary-foreground' : 'border-border group-hover:border-primary'"
                    >
                      <Check class="h-3 w-3 stroke-[3]" x-show="form.funcionalidades.includes(feat.title)" />
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="feat.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="feat.desc"></span>
                    </div>
                  </label>
                </template>
              </div>

              <!-- Campo livre para integração extra -->
              <div class="mt-3">
                <input
                  type="text"
                  placeholder="Outra integração ou sistema específico? (Ex: API interna, Totvs, Bling, Asaas...)"
                  x-model="form.funcionalidadeOutra"
                  class="w-full rounded-xl border border-border/80 bg-background/90 px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                />
              </div>
            </div>

            <!-- 2.3 Pagamento e Vendas Online -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                Se for vender produtos ou serviços, como será o pagamento? <span class="text-primary">*</span>
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Diga se o fechamento ocorre no próprio site via gateway ou fora dele.
              </p>

              <div class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
                <template x-for="item in pagamentosDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.tipoPagamento === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="tipoPagamento"
                      :value="item.title"
                      x-model="form.tipoPagamento"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.tipoPagamento === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.tipoPagamento === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>
            </div>

            <!-- 2.4 Idiomas -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                O site precisará estar disponível em mais de um idioma? <span class="text-primary">*</span>
              </label>
              <div class="mt-3 grid gap-2.5 sm:grid-cols-3">
                <template x-for="item in idiomasDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-center gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.idiomas === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="idiomas"
                      :value="item.title"
                      x-model="form.idiomas"
                      class="sr-only"
                    />
                    <div
                      class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.idiomas === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.idiomas === item.title"></div>
                    </div>
                    <span class="text-sm font-medium text-foreground" x-text="item.title"></span>
                  </label>
                </template>
              </div>
            </div>
          </div>
        </div>

        <!-- Botões de Ação -->
        <div class="flex items-center justify-between">
          <button
            type="button"
            @click="prevStep()"
            class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-5 py-2.5 text-sm font-medium text-foreground hover:bg-secondary transition-colors"
          >
            <ArrowLeft class="h-4 w-4" />
            Voltar
          </button>
          <button
            type="button"
            @click="nextStep()"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground shadow-[0_0_20px_rgba(183,243,77,0.25)] transition-all hover:shadow-[0_0_28px_rgba(183,243,77,0.4)] hover:brightness-105"
          >
            Próxima etapa: Conteúdo & Design
            <ArrowRight class="h-4 w-4" />
          </button>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- ETAPA 3: CONTEÚDO E DESIGN -->
      <!-- ============================================== -->
      <div x-show="currentStep === 3" x-transition.opacity.duration.250ms class="space-y-6">
        <div class="rounded-2xl border border-border/80 bg-card/60 p-6 sm:p-8 backdrop-blur-sm">
          <div class="flex items-center gap-2.5 text-primary">
            <Palette class="h-5 w-5" />
            <h2 class="font-display text-xl font-semibold text-foreground sm:text-2xl">
              3. Conteúdo e Design
            </h2>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">
            A maturidade dos seus materiais visuais e textuais dita a agilidade de entrega do projeto.
          </p>

          <div class="mt-8 space-y-7">
