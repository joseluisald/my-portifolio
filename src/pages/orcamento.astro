          </button>

          <button
            type="submit"
            class="w-full sm:w-auto group inline-flex items-center justify-center gap-2.5 rounded-full bg-primary px-8 py-3.5 text-base font-bold text-primary-foreground shadow-[0_0_26px_rgba(183,243,77,0.35)] transition-all hover:shadow-[0_0_36px_rgba(183,243,77,0.55)] hover:brightness-105 active:scale-[0.99]"
          >
            <Send class="h-4 w-4" />
            Finalizar & Enviar Briefing no WhatsApp
          </button>
        </div>
      </div>
    </form>

    <!-- MODAL DE EDIÇÃO DOS DADOS DO CLIENTE (Nome e Telefone) -->
    <div
      x-show="showClientModal"
      x-transition.opacity.duration.200ms
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
      style="display: none;"
    >
      <div
        @click.outside="showClientModal = false"
        class="relative w-full max-w-md rounded-2xl border border-primary/30 bg-card p-6 shadow-2xl"
      >
        <div class="flex items-center justify-between border-b border-border/60 pb-3">
          <h3 class="font-display text-lg font-semibold text-foreground">
            Seus Dados de Contato
          </h3>
          <button
            type="button"
            @click="showClientModal = false"
            class="rounded-lg p-1 text-muted-foreground hover:text-foreground"
          >
            ✕
          </button>
        </div>

        <div class="mt-4 space-y-4">
          <div>
            <label class="block text-xs font-semibold text-foreground">Nome completo ou da empresa</label>
            <input
              type="text"
              x-model="clienteNome"
              placeholder="Ex: Carlos Silva"
              class="mt-1.5 w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-foreground">WhatsApp com DDD</label>
            <input
              type="tel"
              x-model="clienteTelefone"
              placeholder="Ex: (11) 98765-4321"
              class="mt-1.5 w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <button
            type="button"
            @click="saveClientData()"
            class="w-full rounded-xl bg-primary py-2.5 text-sm font-bold text-primary-foreground hover:brightness-105"
          >
            Salvar e Continuar
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL DE CONFIRMAÇÃO DE SUCESSO -->
    <div
      x-show="showSuccessModal"
      x-transition.opacity.duration.250ms
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 backdrop-blur-md"
      style="display: none;"
    >
      <div
        class="relative w-full max-w-lg rounded-2xl border border-primary/40 bg-card p-6 sm:p-8 shadow-2xl text-center"
      >
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/20 text-primary">
          <CheckCircle2 class="h-8 w-8" />
        </div>

        <h3 class="mt-4 font-display text-2xl font-bold text-foreground">
          Briefing Gerado com Sucesso!
        </h3>

        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          As informações foram consolidadas e estão prontas para serem enviadas para o WhatsApp da JLA Code.
        </p>

        <div class="mt-6 flex flex-col gap-3">
          <a
            :href="whatsappDirectUrl"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-primary-foreground shadow-[0_0_24px_rgba(183,243,77,0.35)] hover:brightness-105"
          >
            <MessageCircle class="h-4 w-4" />
            Abrir Conversa no WhatsApp Agora
          </a>

          <button
            type="button"
            @click="copyBriefingToClipboard()"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-background/80 px-5 py-2.5 text-xs font-semibold text-foreground hover:bg-secondary transition-colors"
          >
            <Copy class="h-3.5 w-3.5 text-primary" />
            <span x-text="copiedMessage ? 'Copiado para a área de transferência!' : 'Copiar texto completo do briefing'"></span>
          </button>
        </div>

        <div class="mt-6 border-t border-border/50 pt-4 text-xs text-muted-foreground">
          <button
            type="button"
            @click="showSuccessModal = false"
            class="hover:text-primary transition-colors font-mono"
          >
            ← Fechar e revisar respostas
          </button>
        </div>
      </div>
    </div>

  </main>
</Layout>

