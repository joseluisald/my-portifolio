                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.identidadeVisual === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>
            </div>

            <!-- 3.2 Textos (Copy) e Fotos -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                Os textos (copy) e as fotos profissionais já estão prontos? <span class="text-primary">*</span>
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                A criação de textos persuasivos (copywriting) e curadoria de imagens podem ser incluídas no escopo se você precisar.
              </p>

              <div class="mt-3.5 space-y-2.5">
                <template x-for="item in conteudoDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.conteudoCopy === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="conteudoCopy"
                      :value="item.title"
                      x-model="form.conteudoCopy"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.conteudoCopy === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.conteudoCopy === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>
            </div>
          </div>
        </div>

        <!-- Botões de Ação -->
        <div class="flex items-center justify-between">
          <button
            type="button"
            @click="prevStep()"
            class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-5 py-2.5 text-sm font-medium text-foreground hover:bg-secondary transition-colors"
          >
            <ArrowLeft class="h-4 w-4" />
            Voltar
          </button>
          <button
            type="button"
            @click="nextStep()"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground shadow-[0_0_20px_rgba(183,243,77,0.25)] transition-all hover:shadow-[0_0_28px_rgba(183,243,77,0.4)] hover:brightness-105"
          >
            Próxima etapa: Infraestrutura & Prazos
            <ArrowRight class="h-4 w-4" />
          </button>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- ETAPA 4: INFRAESTRUTURA E PRAZOS -->
      <!-- ============================================== -->
      <div x-show="currentStep === 4" x-transition.opacity.duration.250ms class="space-y-6">
        <div class="rounded-2xl border border-border/80 bg-card/60 p-6 sm:p-8 backdrop-blur-sm">
          <div class="flex items-center gap-2.5 text-primary">
            <Server class="h-5 w-5" />
            <h2 class="font-display text-xl font-semibold text-foreground sm:text-2xl">
              4. Infraestrutura, Prazos & Manutenção
            </h2>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">
            Últimos detalhes para organizarmos o cronograma e a entrega técnica do projeto.
          </p>

          <div class="mt-8 space-y-7">
            <!-- 4.1 Domínio e Hospedagem -->
            <div>
              <label class="block text-sm font-semibold text-foreground">
                Você já tem o domínio registrado (ex: suaempresa.com.br) e hospedagem? <span class="text-primary">*</span>
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Se não tiver, orientamos ou realizamos toda a contratação e apontamento DNS.
              </p>

              <div class="mt-3.5 space-y-2.5">
                <template x-for="item in dominioDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.dominioHospedagem === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="dominioHospedagem"
                      :value="item.title"
                      x-model="form.dominioHospedagem"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.dominioHospedagem === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.dominioHospedagem === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>

              <!-- Campo se já tiver domínio -->
              <div class="mt-3" x-show="form.dominioHospedagem.includes('Sim') || form.dominioHospedagem.includes('Apenas')">
                <input
                  type="text"
                  placeholder="Qual é o endereço do seu domínio? (Ex: www.suaempresa.com.br)"
                  x-model="form.dominioNome"
                  class="w-full rounded-xl border border-border/80 bg-background/90 px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                />
              </div>
            </div>

            <!-- 4.2 Data Limite e Urgência -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                Existe alguma data limite ou urgência para o site estar no ar? <span class="text-primary">*</span>
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Projetos com prazo ultra curto exigem alocação prioritária e dedicação exclusiva.
              </p>

              <div class="mt-3.5 grid gap-2.5 sm:grid-cols-3">
                <template x-for="item in prazosDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.prazoUrgencia === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="prazoUrgencia"
                      :value="item.title"
                      x-model="form.prazoUrgencia"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.prazoUrgencia === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.prazoUrgencia === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>

              <!-- Data específica opcional -->
              <div class="mt-3">
                <input
                  type="text"
                  placeholder="Data limite específica desejada (Ex: Até 15 de novembro, ou 'Antes do lançamento da marca')"
                  x-model="form.prazoDataEspecifica"
                  class="w-full rounded-xl border border-border/80 bg-background/90 px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                />
              </div>
            </div>

            <!-- 4.3 Plano de Manutenção Mensal -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                Você tem interesse em um plano de manutenção mensal após a entrega? <span class="text-primary">*</span>
              </label>
              <p class="mt-1 text-xs text-muted-foreground">
                Para atualizações de segurança, backups automáticos, melhorias de performance e pequenas edições recorrentes.
              </p>

              <div class="mt-3.5 space-y-2.5">
                <template x-for="item in manutencaoDisponiveis" :key="item.id">
                  <label
                    class="group relative flex cursor-pointer items-start gap-3 rounded-xl border p-3.5 transition-all"
                    :class="form.manutencaoMensal === item.title ? 'border-primary bg-primary/10 shadow-[0_0_15px_rgba(183,243,77,0.1)]' : 'border-border/60 bg-background/50 hover:border-primary/40 hover:bg-card/80'"
                  >
                    <input
                      type="radio"
                      name="manutencaoMensal"
                      :value="item.title"
                      x-model="form.manutencaoMensal"
                      class="sr-only"
                    />
                    <div
                      class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-all"
                      :class="form.manutencaoMensal === item.title ? 'border-primary bg-primary' : 'border-border group-hover:border-primary'"
                    >
                      <div class="h-1.5 w-1.5 rounded-full bg-primary-foreground" x-show="form.manutencaoMensal === item.title"></div>
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-foreground" x-text="item.title"></span>
                      <span class="block text-xs text-muted-foreground mt-0.5" x-text="item.desc"></span>
                    </div>
                  </label>
                </template>
              </div>
            </div>

            <!-- 4.4 Observações Adicionais -->
            <div class="border-t border-border/40 pt-6">
              <label class="block text-sm font-semibold text-foreground">
                Alguma observação importante ou requisito que não mencionamos?
              </label>
              <div class="mt-3">
                <textarea
                  rows="3"
                  x-model="form.observacoes"
                  placeholder="Fique à vontade para adicionar qualquer detalhe, expectativa de investimento ou particularidade do seu negócio..."
                  class="w-full rounded-xl border border-border/80 bg-background/90 p-3.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                ></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- Botões de Envio Final -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <button
            type="button"
            @click="prevStep()"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-border bg-card px-5 py-3 text-sm font-medium text-foreground hover:bg-secondary transition-colors"
          >
            <ArrowLeft class="h-4 w-4" />
