        { id: 2, title: 'Tenho fotos/ideias, mas preciso de apoio com textos comerciais', desc: 'Criamos a redação publicitária (copywriting) com foco em venda.' },
        { id: 3, title: 'Não tenho textos nem fotos profissionais, precisarei de tudo', desc: 'Estruturação completa de copy, bancos de imagem de alta definição e gráficos.' }
      ],

      dominioDisponiveis: [
        { id: 1, title: 'Já possuo domínio registrado e hospedagem contratada', desc: 'Basta realizar a implantação e a publicação técnica.' },
        { id: 2, title: 'Já possuo domínio registrado, mas preciso de hospedagem moderna', desc: 'Configuramos infraestrutura ultrarrápida com CDN e SSL grátis.' },
        { id: 3, title: 'Não tenho domínio nem hospedagem, preciso de suporte total', desc: 'Orientamos a compra segura no Registro.br e cuidamos de tudo.' }
      ],

      prazosDisponiveis: [
        { id: 1, title: 'Sem pressa / Flexível (ritmo normal)', desc: 'Prioridade em polimento e desenvolvimento no fluxo padrão.' },
        { id: 2, title: 'Prazo padrão (2 a 4 semanas)', desc: 'Cronograma saudável para desenvolvimento, testes e ajustes.' },
        { id: 3, title: 'Urgente (Data limite crítica)', desc: 'Lançamento com data improrrogável; exige fila de prioridade.' }
      ],

      manutencaoDisponiveis: [
        { id: 1, title: 'Sim, quero suporte contínuo, backups e manutenção técnica', desc: 'Garante site sempre rápido, protegido contra invasões e atualizado.' },
        { id: 2, title: 'Gostaria de conhecer os planos e valores de manutenção', desc: 'Apresentaremos as modalidades de suporte mensal junto à proposta.' },
        { id: 3, title: 'No momento prefiro apenas a entrega pontual do projeto', desc: 'Entrega final com treinamento básico sem mensalidade fixa.' }
      ],

      init() {
        // 1. Ler parâmetros da URL (?nome=...&telefone=... ou ?name=...&phone=...)
        const params = new URLSearchParams(window.location.search);
        const urlNome = params.get('nome') || params.get('name') || params.get('cliente') || '';
        const urlTel = params.get('telefone') || params.get('tel') || params.get('phone') || params.get('whatsapp') || params.get('celular') || '';

        if (urlNome) {
          this.clienteNome = decodeURIComponent(urlNome.replace(/\+/g, ' '));
        }
        if (urlTel) {
          this.clienteTelefone = decodeURIComponent(urlTel.replace(/\+/g, ' '));
        }

        // Se não tiver nome, abre o modal de identificação amigável suavemente
        if (!this.clienteNome) {
          setTimeout(() => {
            this.showClientModal = true;
          }, 600);
        }

        // Tentar recuperar do localStorage se o usuário tiver começado antes
        try {
          const saved = localStorage.getItem('jla_briefing_draft');
          if (saved) {
            const parsed = JSON.parse(saved);
            this.form = { ...this.form, ...parsed.form };
            if (!this.clienteNome && parsed.clienteNome) this.clienteNome = parsed.clienteNome;
            if (!this.clienteTelefone && parsed.clienteTelefone) this.clienteTelefone = parsed.clienteTelefone;
          }
        } catch (e) {}

        // Salvar progresso automaticamente ao alterar
        this.$watch('form', () => {
          this.persistDraft();
        });
      },

      persistDraft() {
        try {
          localStorage.setItem('jla_briefing_draft', JSON.stringify({
            form: this.form,
            clienteNome: this.clienteNome,
            clienteTelefone: this.clienteTelefone
          }));
        } catch (e) {}
      },

      saveClientData() {
        this.showClientModal = false;
        this.persistDraft();
      },

      goToStep(stepNumber) {
        this.currentStep = stepNumber;
        window.scrollTo({ top: 120, behavior: 'smooth' });
      },

      nextStep() {
        if (this.currentStep < 4) {
          this.currentStep++;
          window.scrollTo({ top: 120, behavior: 'smooth' });
        }
      },

      prevStep() {
        if (this.currentStep > 1) {
          this.currentStep--;
          window.scrollTo({ top: 120, behavior: 'smooth' });
        }
      },

      buildBriefingSummary() {
        const n = this.clienteNome || 'Não informado';
        const t = this.clienteTelefone || 'Não informado';
        const f = this.form;

        const objFinal = f.objetivoPrincipal === 'Outro objetivo específico' && f.objetivoOutro
          ? `Outro: ${f.objetivoOutro}`
          : f.objetivoPrincipal;

        const feats = f.funcionalidades.length > 0
          ? f.funcionalidades.map(x => `  • ${x}`).join('\n')
          : '  • Nenhuma funcionalidade especial';

        const featExtra = f.funcionalidadeOutra ? `\n  • Extra: ${f.funcionalidadeOutra}` : '';
        const domInfo = f.dominioNome ? ` (${f.dominioNome})` : '';
        const prazoData = f.prazoDataEspecifica ? ` (Data limite: ${f.prazoDataEspecifica})` : '';

        return `📋 *NOVO BRIEFING DE PROJETO | JLA CODE*

👤 *CLIENTE*
• Nome: ${n}
• WhatsApp: ${t}

🎯 *1. OBJETIVO E REFERÊNCIAS*
• Objetivo Principal: ${objFinal}
• Referências visuais: ${f.referenciasSites || 'Nenhuma informada'}
• Concorrentes: ${f.concorrentes || 'Nenhum informado'}

🧱 *2. ESTRUTURA E FUNCIONALIDADES*
• Páginas estimadas: ${f.quantidadePaginas}${f.paginasDetalhes ? ` (${f.paginasDetalhes})` : ''}
• Recursos & Integrações:
${feats}${featExtra}
• Pagamento / Vendas: ${f.tipoPagamento}
• Idiomas: ${f.idiomas}

🎨 *3. CONTEÚDO E DESIGN*
• Identidade Visual: ${f.identidadeVisual}
• Textos e Fotos: ${f.conteudoCopy}

⚡ *4. INFRAESTRUTURA E PRAZOS*
• Domínio & Hospedagem: ${f.dominioHospedagem}${domInfo}
• Prazo & Urgência: ${f.prazoUrgencia}${prazoData}
• Manutenção Mensal: ${f.manutencaoMensal}
• Observações extras: ${f.observacoes || 'Nenhuma'}

---
Enviado via jlacode.com.br/orcamento`;
      },

      buildWhatsAppNotification() {
        const n = this.clienteNome ? this.clienteNome.trim() : 'Cliente';
        const f = this.form;
        const obj = f.objetivoPrincipal === 'Outro objetivo específico' && f.objetivoOutro
          ? f.objetivoOutro
          : f.objetivoPrincipal;

        return `Olá, José! 👋

Acabei de enviar meu formulário de orçamento pelo site da *JLA Code*.

👤 *Nome:* ${n}
🎯 *Objetivo:* ${obj}

Já preenchi todos os detalhes e requisitos do projeto. Fico no aguardo do seu contato para avaliarmos a proposta! 🚀`;
      },

      async submitBriefing() {
        // Gera o briefing técnico detalhado para salvar no JSON do servidor
        this.formattedBriefingText = this.buildBriefingSummary();

        // Gera a mensagem curta, elegante e amigável para o WhatsApp
        const waMessage = this.buildWhatsAppNotification();
        const encoded = encodeURIComponent(waMessage);
        this.whatsappDirectUrl = `https://wa.me/${whatsappNumber}?text=${encoded}`;

        // Salvar cópia local
        this.persistDraft();

        // 1. Gravar imediatamente no arquivo JSON do servidor via API
        try {
          await fetch('/api/briefings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              cliente: {
                nome: this.clienteNome || 'Cliente Anônimo',
                telefone: this.clienteTelefone || '',
              },
              form: this.form,
              resumoFormatado: this.formattedBriefingText
            })
          });
        } catch (err) {
          console.warn('Não foi possível salvar na API em segundo plano:', err);
        }

        // 2. Abre WhatsApp diretamente
        window.open(this.whatsappDirectUrl, '_blank');

        // 3. Exibe modal elegante de confirmação
        this.showSuccessModal = true;
      },

      copyBriefingToClipboard() {
        navigator.clipboard.writeText(this.formattedBriefingText).then(() => {
          this.copiedMessage = true;
          setTimeout(() => {
            this.copiedMessage = false;
          }, 3000);
        });
      }
    }));
  });
</script>
